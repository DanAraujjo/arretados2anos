# Local / produção (gitignored → copie para .env.local)

# URL pública das fotos (sem barra no final)
# GitHub + jsDelivr (sem cartão):
#   https://cdn.jsdelivr.net/gh/SEU_USER/arretados-photos@main
#   ou ...@main/photos se as imagens estiverem nessa pasta
NEXT_PUBLIC_PHOTOS_BASE_URL=

# R2 (opcional — Cloudflare pede cartão)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=arretados-photos
# R2_PREFIX=photos
